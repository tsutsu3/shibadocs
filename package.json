{
  "name": "shibadocs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" build",
    "typecheck": "pnpm --filter \"./packages/**\" typecheck",
    "test": "pnpm --filter \"./packages/**\" test",
    "test:update": "pnpm --filter \"./packages/**\" test -u",
    "lab:browser": "pnpm --filter @shibadocs-lab/typst-browser",
    "lab:ref": "pnpm --filter @shibadocs-lab/reference-impl",
    "lab:baseline": "pnpm --filter @shibadocs-lab/baseline"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
