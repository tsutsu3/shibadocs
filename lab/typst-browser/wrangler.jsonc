{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shibadocs-lab-typst-browser",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-20",
  // The built harness. Everything except the compiler wasm fits the 25 MiB
  // per-file limit of static assets, and the edge compresses it per request.
  // Assets are matched before the Worker runs, so no ASSETS binding is needed:
  // the Worker only sees what matched nothing.
  "assets": {
    "directory": "./dist",
  },
  // The compiler wasm is 27.01 MiB, which is over that limit, so it is served
  // from R2 by the Worker instead. See src/worker.ts.
  "r2_buckets": [
    {
      "binding": "WASM",
      "bucket_name": "shibadocs-lab-wasm",
    },
  ],

  // Workers Cache. Cache-Control on the response decides what is kept, and the
  // Worker does not run on a hit. Entries are keyed by Worker version, so a
  // deploy drops the old ones.
  "cache": {
    "enabled": true,
  },

  "observability": {
    "enabled": true,
    // "head_sampling_rate": 1
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
  },
}
